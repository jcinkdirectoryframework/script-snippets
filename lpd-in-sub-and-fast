(() => {
    console.log('🔴 V1 Script started');
    
    // Ensure edit_sub_user exists globally
    if (typeof window.edit_sub_user !== 'function') {
        console.log('📝 Defining edit_sub_user');
        window.edit_sub_user = function() {
            const menu = document.getElementById('post_as_menu');
            if (menu && menu.value == -1) {
                const selector = document.getElementById('post_as_selector');
                if (selector) {
                    selector.innerHTML = "<input type='text' class='forminput' name='post_as_username' size='40' placeholder='Enter username of any member here...'>";
                }
            }
        };
    }

    function calcTimeAgo(date) {
        const s = Math.floor((new Date() - date) / 1e3);
        if (s < 60) return 'Just now';
        const m = Math.floor(s / 60);
        if (m < 60) return `${m} minute${m > 1 ? 's' : ''} ago`;
        const h = Math.floor(m / 60);
        if (h < 24) return `${h} hour${h > 1 ? 's' : ''} ago`;
        const d = Math.floor(h / 24);
        if (d < 7) return `${d} day${d > 1 ? 's' : ''} ago`;
        const w = Math.floor(d / 7);
        if (d < 30) return `${w} week${w > 1 ? 's' : ''} ago`;
        const mo = Math.floor(d / 30);
        if (d < 365) return `${mo} month${mo > 1 ? 's' : ''} ago`;
        const y = Math.floor(d / 365);
        return `${y} year${y > 1 ? 's' : ''} ago`;
    }

    function parseTime(s) {
        if (!s) return 'No posts yet';
        let d = new Date(s);
        if (!isNaN(d)) return calcTimeAgo(d);
        
        const today = s.match(/^Today at (\d{1,2}):(\d{2})\s*(am|pm)$/i);
        if (today) {
            let h = +today[1];
            const m = +today[2];
            if (today[3].toLowerCase() === 'pm' && h < 12) h += 12;
            if (today[3].toLowerCase() === 'am' && h === 12) h = 0;
            const now = new Date();
            return calcTimeAgo(new Date(now.getFullYear(), now.getMonth(), now.getDate(), h, m));
        }
        
        const yesterday = s.match(/^Yesterday at (\d{1,2}):(\d{2})\s*(am|pm)$/i);
        if (yesterday) {
            let h = +yesterday[1];
            const m = +yesterday[2];
            if (yesterday[3].toLowerCase() === 'pm' && h < 12) h += 12;
            if (yesterday[3].toLowerCase() === 'am' && h === 12) h = 0;
            const now = new Date();
            return calcTimeAgo(new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, h, m));
        }
        
        const rel = s.match(/^(\d+)\s+(minute|minutes|hour|hours|day|days|week|weeks|month|months|year|years)\s+ago$/i);
        if (rel) {
            const n = +rel[1];
            const u = rel[2].toLowerCase();
            const now = new Date();
            const past = new Date(now);
            if (u.startsWith('minute')) past.setMinutes(now.getMinutes() - n);
            else if (u.startsWith('hour')) past.setHours(now.getHours() - n);
            else if (u.startsWith('day')) past.setDate(now.getDate() - n);
            else if (u.startsWith('week')) past.setDate(now.getDate() - n * 7);
            else if (u.startsWith('month')) past.setMonth(now.getMonth() - n);
            else if (u.startsWith('year')) past.setFullYear(now.getFullYear() - n);
            return calcTimeAgo(past);
        }
        
        d = new Date(s.replace(/(\d{1,2}):(\d{2})\s*(am|pm)/i, (match, h, m, ap) => {
            let hours = +h;
            if (ap.toLowerCase() === 'pm' && hours < 12) hours += 12;
            if (ap.toLowerCase() === 'am' && hours === 12) hours = 0;
            return `${hours}:${m}`;
        }));
        if (!isNaN(d)) return calcTimeAgo(d);
        
        return s.toLowerCase() === 'just now' || s === 'Now' ? 'Just now' : 'Unavailable';
    }

    async function update(select, context = '') {
        console.log(`🔄 Updating ${context} select:`, select);
        if (select.dataset.loaded) {
            console.log(`⏭️ ${context} already loaded, skipping`);
            return;
        }
        select.dataset.loaded = 1;
        const opts = [...select.options].filter(o => o.value && o.value !== '0' && o.value !== '-1' && o.value !== '------------' && !isNaN(o.value));
        console.log(`📝 ${context} found ${opts.length} accounts to process`);
        if (!opts.length) return;
        
        await Promise.all(opts.map(async o => {
            const name = o.textContent.trim();
            console.log(`🔎 Processing ${context} account: ${name} (ID: ${o.value})`);
            try {
                const res = await fetch(`/index.php?showuser=${o.value}`, { credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const html = await res.text();
                const doc = new DOMParser().parseFromString(html, 'text/html');
                const last = doc.querySelector('.last-post')?.textContent.trim();
                console.log(`📝 ${context} ${name} last post:`, last);
                o.textContent = `${name} - Last post: ${parseTime(last)}`;
            } catch (e) {
                console.error(`❌ ${context} Error for ${name}:`, e);
                o.textContent = `${name} - Last post: Unavailable`;
            }
        }));
        console.log(`✅ ${context} update complete`);
        
        if (select.onchange) {
            const event = new Event('change', { bubbles: true });
            select.dispatchEvent(event);
        }
    }

    function find() {
        console.log('🔍 Running find()...');
        let found = false;
        
        const sub = document.querySelector('#subacct_link select');
        console.log('🔍 #subacct_link select:', sub);
        if (sub && [...sub.options].some(o => o.value && o.value !== '------------' && !isNaN(o.value))) {
            console.log('✅ Found subaccounts select, updating...');
            update(sub, 'Subaccounts');
            found = true;
        }
        
        if (location.href.includes('act=ST')) {
            console.log('🔍 On act=ST page, looking for fast reply...');
            const fast = document.querySelector('#post_as_selector select#post_as_menu');
            console.log('🔍 Fast reply select:', fast);
            if (fast && [...fast.options].some(o => o.value && o.value !== '0' && o.value !== '-1' && !isNaN(o.value))) {
                console.log('✅ Found fast reply select, updating...');
                update(fast, 'Fast Reply');
                found = true;
            }
        } else {
            console.log('ℹ️ Not on act=ST page');
        }
        
        console.log(`🔍 find() complete, found: ${found}`);
        return found;
    }

    function observe() {
        console.log('👀 Setting up observers...');
        
        const el = document.querySelector('#subacct_link');
        console.log('🔍 #subacct_link element:', el);
        if (el) {
            const obs = new MutationObserver(() => {
                console.log('👀 Subaccounts mutation detected');
                const s = document.querySelector('#subacct_link select');
                if (s && !s.dataset.loaded) {
                    console.log('✅ Found subaccounts select via observer, updating...');
                    update(s, 'Subaccounts');
                }
            });
            obs.observe(el, { childList: true, subtree: true });
            console.log('✅ Subaccounts observer set up');
        } else {
            console.log('❌ #subacct_link not found');
        }
        
        if (location.href.includes('act=ST')) {
            console.log('🔍 Setting up fast reply observers...');
            const btn = document.querySelector('a[href*="ShowHide"][href*="qr_open"]');
            console.log('🔍 Fast Reply button:', btn);
            if (btn) {
                btn.addEventListener('click', () => {
                    console.log('🔄 Fast Reply button clicked');
                    setTimeout(() => {
                        const s = document.querySelector('#post_as_selector select#post_as_menu');
                        console.log('🔍 Fast reply select after click:', s);
                        if (s && !s.dataset.loaded) {
                            console.log('✅ Found fast reply select after click, updating...');
                            update(s, 'Fast Reply');
                        }
                    }, 200);
                });
                console.log('✅ Fast Reply button listener set up');
            } else {
                console.log('❌ Fast Reply button not found');
            }
            
            const obs = new MutationObserver(() => {
                console.log('👀 Fast reply mutation detected');
                const s = document.querySelector('#post_as_selector select#post_as_menu');
                if (s && !s.dataset.loaded) {
                    console.log('✅ Found fast reply select via observer, updating...');
                    update(s, 'Fast Reply');
                }
            });
            obs.observe(document.body, { childList: true, subtree: true });
            console.log('✅ Fast reply observer set up');
        }
        console.log('👀 Observers setup complete');
    }

    if (!find()) {
        console.log('ℹ️ No selects found initially, setting up observers...');
        observe();
    } else {
        console.log('✅ Initial find() found selects, observers not needed');
    }
    console.log('🔴 V1 Script ended');
})();
